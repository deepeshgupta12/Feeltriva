# Feeltriva web — public build configuration.
# Everything here is compiled into the browser bundle and is therefore PUBLIC.
# Never put secrets, provider keys or service credentials in this file.

# mock (default): in-memory deterministic demo scenarios, no network calls.
# http: talk to the FastAPI assessment service described by specs/openapi.json.
VITE_SERVICE_MODE=mock

# Base URL of the assessment API (used only when VITE_SERVICE_MODE=http).
VITE_API_BASE_URL=http://localhost:8000

# Local development auth. When true, requests carry "Authorization: Bearer dev:<uuid>"
# where the UUID is generated once per page load and held in memory only.
# Must stay false outside local development; real auth is a TODO boundary in src/api/http/auth.ts.
VITE_DEV_AUTH=false

# Demo tools (scenario switcher + reviewer preview). Defaults to on in mock mode and
# in the dev server, off in production builds that use http mode. Set true/false to force.
# VITE_DEMO_TOOLS=true
