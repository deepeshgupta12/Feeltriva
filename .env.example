# Copy to .env for local development. Values below match infra/docker-compose.yml dev defaults
# and are NOT secrets. Never put real credentials in this file.
APP_ENV=development
CLINICAL_MODE_ENABLED=false

# Auth. `mock` accepts `Authorization: Bearer dev:<subject>` and is refused outside development/test.
AUTH_MODE=mock
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# The API connects as the least-privilege role (row-level security applies); migrations use the owner.
DATABASE_URL=postgresql+psycopg://feeltriva_app:feeltriva_app_dev@127.0.0.1:5440/feeltriva
MIGRATION_DATABASE_URL=postgresql+psycopg://feeltriva:feeltriva_dev@127.0.0.1:5440/feeltriva

# Fernet key for session free text. Empty uses a built-in, non-secret key in development/test only.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
SESSION_TTL_MINUTES=1440
IDEMPOTENCY_TTL_MINUTES=1440
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

REDIS_URL=
# Private object storage for the raw source archives (S3 API). These match the development
# defaults in infra/docker-compose.yml and are NOT secrets.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9010
OBJECT_STORAGE_BUCKET=feeltriva-raw
OBJECT_STORAGE_ACCESS_KEY=feeltriva
OBJECT_STORAGE_SECRET_KEY=feeltriva_dev_storage
OBJECT_STORAGE_REGION=us-east-1

# Providers. Only `mock` is implemented; no external model provider is called.
LLM_PROVIDER=mock
LLM_MODEL_ID=
LLM_API_KEY=
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_ID=

# Clinical mode requires an approved, non-synthetic release bundle and a non-mock extractor.
RULE_BUNDLE_PATH=
KNOWLEDGE_RELEASE_ID=
RULE_BUNDLE_ID=
MODEL_RELEASE_ID=
ALLOW_EXTERNAL_HEALTH_DATA_PROCESSING=false
RAW_PROMPT_LOGGING=false
