  "components": {
    "schemas": {
      "Demographics": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "age_years": {
            "type": "integer",
            "minimum": 0,
            "maximum": 130
          },
          "gender_identity": {
            "type": "string",
            "maxLength": 100
          },
          "clinically_relevant_context": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": []
      },
      "SessionCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "consent_version": {
            "type": "string",
            "minLength": 1
          },
          "demographics": {
            "$ref": "#/components/schemas/Demographics"
          }
        },
        "required": [
          "consent_version"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid"
          },
          "observation_version": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObservationRecord"
            }
          },
          "demographics": {
            "$ref": "#/components/schemas/Demographics"
          }
        },
        "required": [
          "session_id",
          "observation_version",
          "state",
          "expires_at",
          "observations"
        ]
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "feature_id": {
            "type": "string"
          },
          "presence": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "uncertain",
              "not_asked"
            ]
          },
          "value": {},
          "onset": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          },
          "supersedes": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "feature_id",
          "presence",
